# WendaoIotPanel 门户镜像：web-admin 管理后台 + wiki 静态站 + 反代后端
# 多阶段构建：node:20 构建前端 → nginx:alpine 服务
#
# 构建（在仓库根目录）：
#   docker build -f deploy/docker/Dockerfile.portal -t wendao/portal:latest .
#
# npm 慢时可覆盖： --build-arg NPM_REGISTRY=https://registry.npmmirror.com

# ---- 前端构建阶段 ----
FROM node:20-alpine AS webbuild

ARG NPM_REGISTRY=https://registry.npmmirror.com

WORKDIR /build

# web-admin：Element Plus 管理后台（构建产物 dist/）
COPY web-admin/package.json web-admin/package-lock.json* ./web-admin/
RUN cd web-admin && npm config set registry ${NPM_REGISTRY} && npm install --no-audit --no-fund

COPY web-admin/ ./web-admin/
RUN cd web-admin && npm run build

# ---- 运行阶段 ----
FROM nginx:1.27-alpine

ARG NPM_REGISTRY=https://registry.npmmirror.com

# web-admin 静态资源
COPY --from=webbuild /build/web-admin/dist/ /var/www/admin/

# 站点配置：panel.wendaoiot.com（admin + 反代）与 wiki.wendaoiot.com（静态站）
COPY deploy/docker/nginx/panel.conf /etc/nginx/conf.d/default.conf

# wiki 静态站由宿主目录只读挂载到 /var/www/wiki（compose 声明），镜像内只建挂载点
RUN mkdir -p /var/www/wiki

EXPOSE 80
