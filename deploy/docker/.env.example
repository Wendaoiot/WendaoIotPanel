# WendaoIotPanel 容器栈环境变量（MySQL + 独立 MQTT broker + Go 后端 + Nginx）
# 用法： cp .env.example .env 然后修改全部 change_me 值（.env 不入库）
#       生产建议用 gen-secrets.sh 直接生成强密钥版 .env

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_mysql_root_24
MYSQL_APP_PASSWORD=change_me_mysql_app_24
MYSQL_DATABASE=wendaoiot

# ---- 后端 HTTP ----
WQ_JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long
WQ_CORS_ORIGINS=https://panel.wendaoiot.com
WQ_ADMIN_USERNAME=admin
WQ_ADMIN_PASSWORD=change_me_admin_password

# ---- 独立 MQTT broker ----
# 设备连接 1883/8883；平台自身账号（后端业务 MQTT 客户端使用）
MQTT_PORT=1883
MQTT_TLS_PORT=8883
WQ_BROKER_SERVER_USERNAME=wendao_server
WQ_BROKER_SERVER_PASSWORD=change_me_broker_server_pw_16plus
WQ_MQTT_CLIENT_ID=wendao_server
# broker ↔ 后端内部 HTTP 通道共享密钥（设备状态上报 / 互踢），两端必须一致
WQ_SYNC_SECRET=change_me_sync_secret_at_least_24

# ---- nginx ----
DOMAIN=panel.wendaoiot.com
WIKI_DOMAIN=wiki.wendaoiot.com
# 门户容器宿主端口（宿主 80 被在用 nginx 占用时改用 8088，再由宿主 nginx 反代）
PORTAL_HTTP_PORT=8088
# wiki 静态站宿主目录（只读挂载进 nginx 容器）
WIKI_ROOT=/opt/wendao/web/portal
