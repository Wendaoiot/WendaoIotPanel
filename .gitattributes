# 统一跨平台行尾：在 Linux 服务器上执行的脚本必须为 LF，
# 否则会出现 "bad interpreter: /usr/bin/env bash^M"。

# Shell / Python / 配置文件一律 LF
*.sh   text eol=lf
*.py   text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.env text eol=lf
*.env.example text eol=lf
*.example text eol=lf

# Windows 专用脚本与容器编排
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 文本与配置默认按平台处理
*.md   text
*.yaml text
*.yml  text
*.json text
*.ts   text
*.vue  text
